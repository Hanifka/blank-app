<?xml version="1.0" encoding="UTF-8"?>
<group name="sample_web,">

  <rule id="100001" level="3">
    <description>Web request detected</description>
    <group>web,access_control,</group>
  </rule>

  <rule id="100002" level="5">
    <if_matched_sid>100001</if_matched_sid>
    <match>failed login</match>
    <description>Multiple failed web login attempts</description>
    <group>web,authentication,</group>
  </rule>

  <rule id="100003" level="6">
    <regex>union.*select|drop.*table</regex>
    <description>SQL injection attempt detected</description>
    <group>web,injection,application_attack,</group>
  </rule>

  <rule id="100004" level="4">
    <field name="user_agent">.+</field>
    <description>Suspicious user agent detected</description>
    <group>web,reconnaissance,</group>
  </rule>

  <rule id="100005" level="7">
    <description>Credential access detected via web form</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1556</id>
    </mitre>
    <group>web,credential_access,</group>
  </rule>

  <rule id="100006" level="0" noalert="1">
    <description>Baseline HTTP traffic - no alert</description>
    <group>web,baseline,</group>
  </rule>

  <rule id="100009" level="4">
    <program_name>httpd</program_name>
    <description>Apache access log analysis rule</description>
    <group>web,apache,</group>
  </rule>

  <!-- Example whitelist with CDB list (replace field + list path to your real ones) -->
  <rule id="100010" level="5">
    <list field="srcip" lookup="not_address_match_key">etc/lists/white_list_admin</list>
    <description>Brute force detection rule (excluding whitelisted IPs)</description>
    <group>web,authentication,brute_force,</group>
  </rule>

</group>
