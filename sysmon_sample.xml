<?xml version="1.0" encoding="UTF-8"?>
<group name="sysmon,custom,">

  <!-- Custom base Sysmon rule.
       Tip: you can also make this a child of the built-in Sysmon base rule (61600),
       but keeping it standalone is OK if your decoder/parent rules already tag Sysmon events. -->
  <rule id="61605" level="3">
    <description>Sysmon custom base rule</description>
    <group>sysmon,sysmon_custom_base,</group>
  </rule>

  <!-- Event ID 1: Process Creation - suspicious command line -->
  <rule id="102101" level="7">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bpowershell(\.exe)?\b.*\s-(enc|encodedcommand)\b|\bcmd(\.exe)?\b.*\s\/c\s+.*powershell</field>
    <description>Sysmon - Event 1: suspicious PowerShell encoded command</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>sysmon_event_1,sysmon_suspicious_proc,</group>
  </rule>

  <!-- Event ID 1: suspicious parent process -->
  <rule id="102102" level="8">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|word)\.exe$</field>
    <description>Sysmon - Event 1: suspicious parent process (Word spawning a process)</description>
    <group>sysmon_event_1,sysmon_suspicious_proc,</group>
  </rule>

  <!-- Event ID 11: File Create - suspicious extension -->
  <rule id="102103" level="6">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^11$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(scr|vbs|js)$</field>
    <description>Sysmon - Event 11: suspicious file extension created</description>
    <group>sysmon_event_11,</group>
  </rule>

  <!-- Event ID 3: Network connection - outbound (initiated by host) -->
  <rule id="102201" level="5">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.initiated" type="pcre2">(?i)^true$</field>
    <description>Sysmon - Event 3: outbound network connection</description>
    <group>sysmon_event_3,</group>
  </rule>

  <!-- Event ID 3: suspicious destination -->
  <rule id="102202" level="6">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.destinationHostname" type="pcre2">(?i)(^|\.)malicious\.com$|(^|\.)suspicious\.net$</field>
    <description>Sysmon - Event 3: suspicious destination hostname</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>sysmon_event_3,</group>
  </rule>

  <!-- Event ID 3: unusual destination port -->
  <rule id="102203" level="7">
    <if_sid>61605</if_sid>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.destinationPort">^(4444|5555|6666)$</field>
    <description>Sysmon - Event 3: unusual destination port</description>
    <group>sysmon_event_3,</group>
  </rule>

  <!-- Correlation: multiple suspicious process creation alerts -->
  <rule id="102502" level="10" frequency="3" timeframe="300">
    <if_matched_group>sysmon_suspicious_proc</if_matched_group>
    <description>Correlation - multiple suspicious process creations in 5 minutes</description>
    <group>correlation,sysmon,</group>
  </rule>

  <!-- Correlation: multiple Sysmon network connection alerts -->
  <rule id="102503" level="9" frequency="5" timeframe="600">
    <if_matched_group>sysmon_event_3</if_matched_group>
    <description>Correlation - multiple Sysmon network connection events in 10 minutes</description>
    <group>correlation,sysmon,</group>
  </rule>

</group>
